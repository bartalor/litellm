#!/usr/bin/env bash
# Run `make pre-commit` against a single commit's diff in an isolated worktree.
#
# Usage: check-commit-precommit <commit-ish>
#
# Resolves <commit-ish> (branch, tag, sha, HEAD~2, etc.), creates a detached
# worktree at its parent, applies the commit's diff as staged changes, and
# runs `make pre-commit` there. The worktree is removed on exit.
#
# Refuses to run unless origin/litellm_internal_staging points at the same
# commit as upstream/litellm_internal_staging, because the strict gates in
# `make pre-commit` diff against origin/litellm_internal_staging and a stale
# fork ref produces meaningless results.

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: $(basename "$0") <commit-ish>" >&2
    exit 2
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

ORIGIN_REF="origin/litellm_internal_staging"
UPSTREAM_REF="upstream/litellm_internal_staging"

origin_sha="$(git rev-parse --verify "$ORIGIN_REF" 2>/dev/null || true)"
upstream_sha="$(git rev-parse --verify "$UPSTREAM_REF" 2>/dev/null || true)"

if [[ -z "$origin_sha" ]]; then
    echo "Refusing: $ORIGIN_REF does not exist." >&2
    exit 1
fi
if [[ -z "$upstream_sha" ]]; then
    echo "Refusing: $UPSTREAM_REF does not exist." >&2
    exit 1
fi
if [[ "$origin_sha" != "$upstream_sha" ]]; then
    echo "Refusing: $ORIGIN_REF ($origin_sha) != $UPSTREAM_REF ($upstream_sha)." >&2
    echo "Update the fork ref before running strict gates." >&2
    exit 1
fi

sha="$(git rev-parse --verify "$1^{commit}")"
parent="$(git rev-parse --verify "${sha}^")"

worktree_dir="$(mktemp -d -t litellm-precommit-XXXXXX)"

cleanup() {
    git worktree remove --force "$worktree_dir" >/dev/null 2>&1 || true
    rm -rf "$worktree_dir"
}
trap cleanup EXIT

echo "Worktree: $worktree_dir"
echo "Base:     $parent"
echo "Commit:   $sha"
echo

git worktree add --detach "$worktree_dir" "$parent" >/dev/null
git -C "$worktree_dir" cherry-pick --no-commit "$sha"

make -C "$worktree_dir" pre-commit
