#!/usr/bin/env bash
# Verify a bug-fix commit isolates cleanly: test fails on upstream + tests-only
# diff, passes once the source diff is added.
#
# Usage: verify-fix-isolation <ref> <test-file>
#
# Creates a detached worktree at upstream_remote/upstream_branch (from
# *.open-source-utils.toml), applies the `tests/` slice of the diff
# upstream..<ref>, discovers the single `def test_*` added to <test-file>
# by that diff (with its enclosing class, if any), runs it and expects FAIL,
# then applies the `litellm/` slice on top and expects PASS. Refuses if
# <test-file> has 0 or >1 added tests. The worktree is removed on exit.

set -euo pipefail

if [[ $# -ne 2 ]]; then
    echo "usage: $(basename "$0") <ref> <test-file>" >&2
    exit 2
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

shopt -s nullglob
config_matches=(*.open-source-utils.toml)
shopt -u nullglob
if [[ ${#config_matches[@]} -eq 0 ]]; then
    echo "Refusing: no *.open-source-utils.toml file found." >&2
    exit 1
fi
if [[ ${#config_matches[@]} -gt 1 ]]; then
    echo "Refusing: multiple *.open-source-utils.toml files found: ${config_matches[*]}" >&2
    exit 1
fi
CONFIG="${config_matches[0]}"

read_toml_key() {
    local key="$1"
    awk -v k="$key" '
        $1 == k && $2 == "=" {
            gsub(/^"|"$/, "", $3)
            print $3
            exit
        }
    ' "$CONFIG"
}

upstream_remote="$(read_toml_key upstream_remote)"
upstream_branch="$(read_toml_key upstream_branch)"

if [[ -z "$upstream_remote" || -z "$upstream_branch" ]]; then
    echo "Refusing: could not read upstream_remote/upstream_branch from $CONFIG." >&2
    exit 1
fi

base_ref="${upstream_remote}/${upstream_branch}"
git fetch "$upstream_remote" "${upstream_branch}:refs/remotes/${upstream_remote}/${upstream_branch}"
base_sha="$(git rev-parse --verify "$base_ref")"
feature_sha="$(git rev-parse --verify "$1^{commit}")"
test_file="$2"

mapfile -t added_tests < <(
    git diff "$base_sha".."$feature_sha" -- "$test_file" \
        | grep -E '^\+[[:space:]]*def[[:space:]]+test_[A-Za-z0-9_]+' \
        | sed -E 's/^\+[[:space:]]*def[[:space:]]+(test_[A-Za-z0-9_]+).*/\1/'
)

if [[ ${#added_tests[@]} -eq 0 ]]; then
    echo "Refusing: no added 'def test_*' in $test_file between $base_ref and $1." >&2
    exit 1
fi
if [[ ${#added_tests[@]} -gt 1 ]]; then
    echo "Refusing: multiple added tests in $test_file: ${added_tests[*]}" >&2
    exit 1
fi
test_name="${added_tests[0]}"

worktree_dir="$(mktemp -d -t litellm-verify-XXXXXX)"

cleanup() {
    git worktree remove --force "$worktree_dir" >/dev/null 2>&1 || true
    rm -rf "$worktree_dir"
}
trap cleanup EXIT

echo "Worktree: $worktree_dir"
echo "Base:     $base_ref ($base_sha)"
echo "Feature:  $1 ($feature_sha)"
echo "Test fn:  $test_name"
echo

git worktree add --detach "$worktree_dir" "$base_sha" >/dev/null

pytest_bin() {
    if [[ -x "$REPO_ROOT/.venv/bin/pytest" ]]; then
        echo "$REPO_ROOT/.venv/bin/pytest"
    else
        command -v pytest
    fi
}
PYTEST="$(pytest_bin)"

apply_slice() {
    local path="$1"
    if ! git diff "$base_sha".."$feature_sha" -- "$path" | git -C "$worktree_dir" apply --index -; then
        echo "Refusing: failed to apply $path slice." >&2
        exit 1
    fi
}

echo "=== apply tests/ slice, expect FAIL ==="
apply_slice tests/

class_name="$(
    awk -v t="$test_name" '
        /^class[[:space:]]+[A-Za-z_][A-Za-z0-9_]*/ {
            match($0, /^class[[:space:]]+[A-Za-z_][A-Za-z0-9_]*/)
            cls = substr($0, 7, RLENGTH - 6)
            sub(/^[[:space:]]+/, "", cls)
        }
        $0 ~ "^[[:space:]]+def[[:space:]]+" t "[[:space:]]*\\(" { print cls; exit }
    ' "$worktree_dir/$test_file"
)"

if [[ -n "$class_name" ]]; then
    node_id="${test_file}::${class_name}::${test_name}"
else
    node_id="${test_file}::${test_name}"
fi
echo "Node id:  $node_id"

set +e
(cd "$worktree_dir" && "$PYTEST" "$node_id" -x)
rc=$?
set -e
if [[ $rc -ne 1 ]]; then
    echo "FAIL: expected pytest rc=1 (test ran and failed), got rc=$rc." >&2
    echo "  rc=0: test passed without the source fix; test does not pin the bug." >&2
    echo "  rc=4/5: node id not collected; check the test path/class/method name." >&2
    exit 1
fi
echo "OK: test failed as expected."
echo

echo "=== apply litellm/ slice, expect PASS ==="
apply_slice litellm/
(cd "$worktree_dir" && "$PYTEST" "$node_id" -x)
echo "OK: test passed with the source fix."
