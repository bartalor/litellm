#!/usr/bin/env bash
# Point *.open-source-utils.toml at the newest litellm_oss_daily_YYYY_MM_DD
# branch on the upstream remote.
#
# Usage: update-upstream-daily
#
# Discovers the config file (*.open-source-utils.toml, exactly one), reads
# upstream_remote from it, queries that remote for branches matching
# refs/heads/litellm_oss_daily_YYYY_MM_DD, picks the lexicographically
# largest (ISO dates sort chronologically), and rewrites the
# `upstream_branch = "..."` line in place. Prints old -> new.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

shopt -s nullglob
config_matches=(*.open-source-utils.toml)
shopt -u nullglob
if [[ ${#config_matches[@]} -eq 0 ]]; then
    echo "Refusing: no *.open-source-utils.toml file found." >&2
    exit 1
fi
if [[ ${#config_matches[@]} -gt 1 ]]; then
    echo "Refusing: multiple *.open-source-utils.toml files found: ${config_matches[*]}" >&2
    exit 1
fi
CONFIG="${config_matches[0]}"

read_toml_key() {
    local key="$1"
    awk -v k="$key" '
        $1 == k && $2 == "=" {
            gsub(/^"|"$/, "", $3)
            print $3
            exit
        }
    ' "$CONFIG"
}

upstream_remote="$(read_toml_key upstream_remote)"
if [[ -z "$upstream_remote" ]]; then
    echo "Refusing: could not read upstream_remote from $CONFIG." >&2
    exit 1
fi

old_branch="$(read_toml_key upstream_branch)"

upstream_url="$(git remote get-url "$upstream_remote")"
repo_slug="$(
    echo "$upstream_url" \
        | sed -E 's#(git@github\.com:|https://github\.com/)##; s#\.git$##'
)"
if [[ -z "$repo_slug" || "$repo_slug" != */* ]]; then
    echo "Refusing: could not derive <owner>/<repo> from $upstream_url." >&2
    exit 1
fi

newest="$(
    gh api "repos/$repo_slug/branches" --paginate \
        -q '.[].name | select(test("^litellm_oss_daily_[0-9]{4}_[0-9]{2}_[0-9]{2}$"))' \
        | sort \
        | tail -1
)"

if [[ -z "$newest" ]]; then
    echo "Refusing: no litellm_oss_daily_YYYY_MM_DD branch found on $upstream_remote." >&2
    exit 1
fi

if [[ "$old_branch" == "$newest" ]]; then
    echo "Already up to date: $old_branch"
    exit 0
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
sed -E "s|^upstream_branch = \".*\"|upstream_branch = \"$newest\"|" "$CONFIG" > "$tmp"

if ! grep -qE "^upstream_branch = \"$newest\"$" "$tmp"; then
    echo "Refusing: failed to rewrite upstream_branch in $CONFIG." >&2
    exit 1
fi

mv "$tmp" "$CONFIG"
trap - EXIT

echo "$CONFIG: upstream_branch $old_branch -> $newest"
